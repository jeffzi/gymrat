{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "includes": [
    "**/*.{json,yaml,yml,md,toml}"
  ],
  "excludes": [
    "schemas/**",
    "docs/event-reference.md",
    "tests/event_docs/vendor/**"
  ],
  "lineWidth": 100,
  "markdown": {
    "textWrap": "maintain"
  },
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/markdown@0.28.1",
    "npm:@dprint/toml@0.9.0"
  ]
}
