{
  "name": "gymrat",
  "version": "0.5.0",
  "description": "Benchmark candidate revisions against a baseline and get a clear per-metric verdict: improved, regressed, or noise",
  "keywords": [
    "benchmark",
    "benchmarking",
    "benchstat",
    "cli",
    "compare",
    "mitata",
    "performance",
    "wilcoxon"
  ],
  "homepage": "https://github.com/jeffzi/gymrat#readme",
  "bugs": "https://github.com/jeffzi/gymrat/issues",
  "license": "MIT",
  "author": "jeffzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffzi/gymrat.git"
  },
  "bin": {
    "gymrat": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "prepack": "npm run build",
    "check:actions": "actionlint && zizmor .github/workflows",
    "check:fmt": "oxfmt --check",
    "check:lint": "oxlint",
    "check:md": "markdownlint-cli2 \"**/*.md\"",
    "check:package": "run-s build && publint && attw --pack . --profile esm-only",
    "check:quality": "fallow --fail-on-issues --quiet",
    "check:security": "fallow security",
    "check:spelling": "cspell --no-progress --no-must-find-files \"**/*.{ts,tsx,mts,cts,md}\"",
    "check:static": "run-s -c check:lint check:md check:fmt check:actions check:typelint check:spelling check:type",
    "check:type": "tsc -p tsconfig.json --noEmit",
    "check:typelint": "oxlint --type-aware",
    "check": "run-s -c check:static check:quality",
    "fix:fmt": "oxfmt",
    "fix:lint": "oxlint --fix",
    "fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
    "fix:quality": "fallow fix --yes --no-create-config",
    "fix": "run-s fix:lint fix:md fix:fmt",
    "prepare": "test -d .git && lefthook install || true",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@jeffzi/epaulettes": "^0.2.0",
    "@sinclair/typebox": "^0.34.0",
    "@stdlib/stats-wilcoxon": "^0.2.0",
    "commander": "^15.0.0",
    "yocto-spinner": "^1.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "cspell": "^10.0.0",
    "fallow": "^3.17.0",
    "lefthook": "^2.1.0",
    "markdownlint-cli2": "^0.23.0",
    "npm-run-all2": "^9.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.0",
    "publint": "^0.3.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
